# Copy to .env and fill in. Never commit .env.
ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com
CLIENT_ID=your-regular-web-app-client-id
CLIENT_SECRET=your-regular-web-app-client-secret
# Generate with: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
SECRET=long-random-session-secret
BASE_URL=http://localhost:3000
AUDIENCE=https://api.example.test
